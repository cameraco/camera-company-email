# Copy these into Netlify Site configuration > Environment variables.
# Do not commit real secret values to GitHub.

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional. Defaults to:
# /Sales Tracking/Access Sales and Inventory Reporting/customers.csv
DROPBOX_CUSTOMERS_PATH=/Sales Tracking/Access Sales and Inventory Reporting/customers.csv

# Optional. Defaults to:
# /Sales Tracking/Access Sales and Inventory Reporting/sales_export.csv
DROPBOX_EXPORT_PATH=/Sales Tracking/Access Sales and Inventory Reporting/sales_export.csv

# Temporary fallback only. Prefer the app key/secret/refresh token above.
# DROPBOX_ACCESS_TOKEN=
